# ── Django ────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values for your local setup.
# Django will load it automatically via python-dotenv (already installed).

# Required: set a long random secret key
SECRET_KEY=replace-this-with-a-long-random-secret

# Debug mode — keep True in dev, NEVER in production
DEBUG=True

# ── Database ──────────────────────────────────────────────────────────────────
# Option A: full DATABASE_URL (takes priority)
#   PostgreSQL:  DATABASE_URL=postgresql://user:password@localhost:5432/sl_erp
#   SQLite (dev only): DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgresql://sl_erp_user:change-me@localhost:5432/sl_erp

# Option B: individual fields (used when DATABASE_URL is not set)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=sl_erp
DB_USER=sl_erp_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# ── Redis / Celery (optional) ─────────────────────────────────────────────────
# Only needed for background tasks (Celery workers).
# If not set, Celery won't run but Django still starts fine.
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── CORS / CSRF ────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed for CSRF (add your frontend URL here)
# CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Email (optional) ──────────────────────────────────────────────────────────
# In dev, emails print to the console. Set these to use a real SMTP server.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@example.com
# EMAIL_HOST_PASSWORD=yourpassword
