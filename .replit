modules = ["nodejs-20", "python-3.11", "web", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "ERP Frontend"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Django API Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ERP Frontend"

[[workflows.workflow]]
name = "Django API Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'cd backend && export DJANGO_SETTINGS_MODULE=SL_ERP.settings && python manage.py migrate --no-input 2>&1 || true && exec python manage.py runserver 0.0.0.0:8080'"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "ERP Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'PORT=5173 BASE_PATH=/ pnpm --filter @workspace/erp-ui run dev'"
waitForPort = 5173

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["freetype", "gettext", "glibcLocales", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tesseract", "tk", "xcodebuild", "zlib"]
