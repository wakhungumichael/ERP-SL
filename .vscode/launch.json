{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: backend",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["runserver", "0.0.0.0:8080"],
      "django": true,
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "Full stack dev",
      "configurations": ["Django: backend"],
      "preLaunchTask": "Frontend: dev",
      "stopAll": true
    }
  ]
}
