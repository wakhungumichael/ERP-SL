# ── Vite / React frontend ─────────────────────────────────────────────────────
# Copy this to .env for local development.

# Port the Vite dev server listens on (default: 5173)
# PORT=5173

# Base URL path (default: /). Change only if serving the app at a sub-path.
# BASE_PATH=/

# Backend API base URL — where Django is running.
# In local VS Code dev this defaults to http://localhost:8080 (via Vite proxy).
# Override if Django is on a different host/port.
# VITE_API_BASE_URL=http://localhost:8080
